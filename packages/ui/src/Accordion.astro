---
import type { HTMLAttributes } from 'astro/types'

type Props = {
  summary: string
} & HTMLAttributes<'details'>

const { summary, ...props } = Astro.props
---

<details {...props} data-expanded={props.open ? 'true' : 'false'}>
  <summary>
    <p class='heading'>{summary}</p>
    <div class='icon' aria-hidden='true'><div></div><div></div></div>
  </summary>
  <div class='content'><slot /></div>
</details>

<style lang='scss'>
  details {
    position: relative;
    &::before,
    &::after {
      content: '';
      width: 100%;
      height: 1px;
      position: absolute;
      left: 0;
      bottom: -1px;
    }
    &:before {
      background-color: var(--neutral-600);
      transition: opacity 800ms var(--easing);
    }
    &::after {
      background: var(--primary-gradient-400);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 800ms var(--easing);
    }
    &:hover {
      &::before {
        opacity: 0.62;
      }
    }
    &[data-expanded='true'] {
      &::after {
        transform-origin: left;
        transform: scaleX(1);
      }
      .icon {
        div:first-child {
          transform: rotate(0deg);
        }
        div:last-child {
          transform: rotate(-90deg) scaleX(0);
        }
      }
    }
  }
  summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(1rem, calc(2vw / 0.48), 2rem);
    align-items: flex-start;
    padding: 1.25rem 1rem;
    &:active {
      user-select: none;
    }
    .heading {
      font-size: var(--typography-body-xl, 1rem);
      max-width: 44rem;
    }
  }
  .icon {
    width: 22px;
    height: 22px;
    margin-top: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 500ms var(--easing);
    background:
      linear-gradient(var(--neutral-900), var(--neutral-900)) padding-box,
      var(--primary-gradient-400) border-box;
    border: 1px solid transparent;
    border-radius: 50%;
    div {
      width: 8px;
      height: 1px;
      background: var(--primary-gradient-400);
      border-radius: 4px;
      transition: transform 500ms var(--easing);
      &:first-child {
        position: absolute;
        transform: rotate(90deg);
      }
    }
  }
  .content {
    overflow: hidden;
    transition: height 800ms var(--easing);
    margin: 0 1rem;
    max-width: 36rem;
    font-size: var(--typography-body-m, 0.875rem);
    :global(> :last-child) {
      margin-bottom: 1.5rem;
    }
  }
  @media (max-width: 31rem) {
    summary {
      padding-left: 0;
      padding-right: 0;
    }
    .content {
      margin: 0;
    }
  }
</style>

<script>
  document.querySelectorAll('details').forEach((details) => {
    const content = details.querySelector<HTMLDivElement>('.content')
    const summary = details.querySelector<HTMLDivElement>('summary')
    if (!content || !summary) return
    // Single persistent listener (instead of stacked `once` listeners) that
    // settles the state based on data-expanded once the height transition
    // finishes. Stays correct when rapid clicks retarget the transition.
    content.addEventListener('transitionend', (event) => {
      if (event.target !== content) return
      if (details.getAttribute('data-expanded') === 'false') details.open = false
      content.style.height = ''
    })
    summary.addEventListener('click', (event) => {
      event.preventDefault()
      // Branch on data-expanded (set synchronously) instead of details.open,
      // which stays true until the closing transition ends — clicks during
      // that window used to re-run the close branch and get swallowed.
      if (details.getAttribute('data-expanded') === 'true') {
        details.setAttribute('data-expanded', 'false')
        content.style.height = content.scrollHeight + 'px'
        requestAnimationFrame(() => (content.style.height = '0px'))
      } else {
        details.setAttribute('data-expanded', 'true')
        details.open = true
        const startHeight = content.scrollHeight + 'px'
        // When re-opening mid-close, keep the current height so the
        // transition reverses smoothly instead of jumping to 0.
        if (!content.style.height) content.style.height = '0px'
        requestAnimationFrame(() => (content.style.height = startHeight))
      }
    })
  })
</script>
