---
import type { HTMLAttributes } from 'astro/types'

type Props = {
  playbackId: string
  aspectRatio: string
  hideControls?: boolean
  /** The video sits at the top of the page, so its still frame should load first */
  priority?: boolean
} & HTMLAttributes<'div'>

const { playbackId, aspectRatio, hideControls, priority = false, class: className, ...props } = Astro.props

const aspect_ratio = aspectRatio?.replace(':', ' / ')
const [ratioWidth, ratioHeight] = (aspectRatio || '16:9').split(':').map(Number)
const still = (width: number) => `https://image.mux.com/${playbackId}/thumbnail.webp?width=${width}`
const stillImage = videoStill(playbackId)
const playLabel = Astro.params.lang === 'en' ? 'Play video' : 'Odtwórz wideo'

export type VideoDataProps = Props

/**
 * The still frame shown before the player loads. Exported so a page can preload
 * exactly the same picture when the video is the first thing on it.
 */
export const videoStill = (playbackId: string) => {
  const url = (width: number) => `https://image.mux.com/${playbackId}/thumbnail.webp?width=${width}`
  return {
    src: url(960),
    srcset: [480, 640, 768, 960, 1280].map((width) => `${url(width)} ${width}w`).join(', '),
    sizes: '(max-width: 63rem) 100vw, 40rem',
  }
}

export const VideoDataQuery = (name: string) => `
  ${name} {
    "playbackId": asset -> playbackId,
    "aspectRatio": asset -> data.aspect_ratio,
  }
`
---

{
  hideControls ? (
    // A silent loop plays on its own, so the player loads as soon as it comes into view.
    <mux-player
      disable-cookies
      disable-tracking
      playback-id={playbackId}
      primary-color="#fff"
      accent-color="#2DD282"
      style={`aspect-ratio: ${aspect_ratio}; background: url('${still(960)}') center / cover no-repeat; --controls: none;`}
      muted
      autoplay
      loop
      class={className}
      {...props}
    />
  ) : (
    // A video with controls starts as a still frame with a play button. The player
    // (about 290 kB of script) is fetched only when somebody actually presses play.
    <div
      class:list={['video-facade', className]}
      style={`aspect-ratio: ${aspect_ratio};`}
      data-playback-id={playbackId}
      {...props}>
      <img
        src={stillImage.src}
        srcset={stillImage.srcset}
        sizes={stillImage.sizes}
        width={ratioWidth * 100}
        height={ratioHeight * 100}
        alt=""
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
      <button type="button" aria-label={playLabel}>
        {/*
          The drawing fills the whole circle (100 units across). The triangle is
          equilateral and built around its centre of mass, which sits exactly in
          the middle of the circle, so its three corners end up the same distance
          from the ring. That is what makes it look centred. Centring its outline
          box instead would make it look pushed to the left.
        */}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" aria-hidden="true">
          <path
            class="play"
            d="M67.32 50 41.34 65V35Z"
            fill="currentColor"
            stroke="currentColor"
            stroke-width="6"
            stroke-linejoin="round"
          />
          <circle
            class="spinner"
            cx="50"
            cy="50"
            r="15"
            fill="none"
            stroke="currentColor"
            stroke-width="4"
            stroke-linecap="round"
            pathLength="100"
            stroke-dasharray="72 28"
          />
        </svg>
      </button>
    </div>
  )
}

<style lang="scss">
  mux-player {
    display: block;
    overflow: hidden;
    --seek-backward-button: none;
    --seek-forward-button: none;
    --captions-button: none;
    --playback-rate-button: none;
    --pip-button: none;
  }
  .video-facade {
    position: relative;
    display: block;
    overflow: hidden;
    cursor: pointer;
    background: var(--neutral-900, #000103);
    // lets the button take its size from the video, not from the window
    container-type: size;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    // the player created on play inherits these
    --seek-backward-button: none;
    --seek-forward-button: none;
    --captions-button: none;
    --playback-rate-button: none;
    --pip-button: none;
    img,
    :global(mux-player),
    :global(video) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
    img {
      object-fit: cover;
    }
    :global(video) {
      background: #000;
    }
    button {
      position: absolute;
      inset: 0;
      margin: auto;
      // older browsers size the button from the window, newer ones from the video
      width: clamp(3.5rem, calc(4.5vw / 0.48), 4.5rem);
      width: clamp(2.75rem, 28cqmin, 4.5rem);
      // the same two values again: every browser then gets a true circle
      height: clamp(3.5rem, calc(4.5vw / 0.48), 4.5rem);
      height: clamp(2.75rem, 28cqmin, 4.5rem);
      padding: 0;
      border: 0;
      border-radius: 50%;
      color: #fff;
      // dark glass in the brand's green: the footage shows through blurred, so
      // the white triangle stays readable on a bright shirt and on a dark wall
      background-color: rgba(4, 43, 43, 0.8);
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
      box-shadow:
        inset 0 0 0 1px rgba(190, 240, 232, 0.36),
        inset 0 1px 0 0 rgba(255, 255, 255, 0.16),
        0 1px 2px rgba(0, 1, 3, 0.3),
        0 14px 32px -10px rgba(0, 1, 3, 0.65);
      transition:
        transform 220ms var(--easing),
        background-color 220ms ease;
      svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      &:focus-visible {
        outline: 2px solid #90f4e8;
        outline-offset: 3px;
      }
    }
    .play,
    .spinner {
      transform-origin: 50px 50px;
    }
    .play {
      transition:
        opacity 150ms ease,
        transform 220ms var(--easing);
    }
    .spinner {
      opacity: 0;
    }
    @media (hover: hover) and (pointer: fine) {
      &:hover button {
        transform: scale(1.06);
        background-color: rgba(6, 64, 64, 0.9);
      }
    }
    button:focus-visible {
      background-color: rgba(6, 64, 64, 0.9);
    }
    &:active button {
      transform: scale(0.96);
      transition-duration: 120ms;
    }
    // The player is on its way (other browsers than Safari fetch it on the first
    // press). The ring only appears when that takes longer than a blink.
    &[data-started='loading'] {
      cursor: progress;
      .play {
        opacity: 0;
        transform: scale(0.8);
      }
      .spinner {
        opacity: 1;
        transition: opacity 150ms ease 120ms;
        animation: video-facade-spin 700ms linear infinite;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      button,
      .play {
        transition: none;
      }
      &:hover button,
      &:active button {
        transform: none;
      }
      &[data-started='loading'] {
        .play {
          opacity: 0.5;
          transform: none;
        }
        .spinner {
          display: none;
        }
      }
    }
  }
  @keyframes video-facade-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  // Silent loops: load the player when one scrolls into view.
  const observer = new IntersectionObserver(
    async (videos) => {
      for (const video of videos) {
        if (video.isIntersecting) {
          await import('@mux/mux-player')
        }
      }
    },
    { rootMargin: '100px' }
  )
  document.querySelectorAll('mux-player').forEach((video) => {
    observer.observe(video)
  })

  // Videos with controls: swap the still frame for a real player on the first press.
  function loadPlayer(facade: HTMLElement, playbackId: string, poster: string) {
    facade.dataset.started = 'loading'
    import('@mux/mux-player').then(() => {
      const player = document.createElement('mux-player')
      player.setAttribute('playback-id', playbackId)
      player.setAttribute('disable-cookies', '')
      player.setAttribute('disable-tracking', '')
      player.setAttribute('primary-color', '#fff')
      player.setAttribute('accent-color', '#2DD282')
      player.setAttribute('autoplay', '')
      if (poster) player.setAttribute('poster', poster)
      facade.replaceChildren(player)
      facade.dataset.started = 'true'
    }).catch(() => {
      // the script did not arrive (weak connection): let the next press try again
      delete facade.dataset.started
    })
  }

  // iPhones, iPads and Safari play Mux streams on their own, and they only start a
  // video with sound when play() runs inside the tap itself. Fetching the player
  // first would lose that tap, so there the browser's own player is used. Other
  // browsers also claim they can play the format but often cannot, so they get the
  // Mux player, which they are happy to start a moment after the tap.
  const ua = navigator.userAgent
  const isAppleBrowser =
    /iP(hone|ad|od)/.test(ua) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1) ||
    /^((?!chrome|chromium|android|crios|fxios|edg).)*safari/i.test(ua)

  function play(facade: HTMLElement) {
    if (facade.dataset.started) return
    const playbackId = facade.dataset.playbackId
    if (!playbackId) return
    const poster = facade.querySelector('img')?.currentSrc || ''

    const video = document.createElement('video')
    if (isAppleBrowser && video.canPlayType('application/vnd.apple.mpegurl')) {
      facade.dataset.started = 'true'
      video.src = `https://stream.mux.com/${playbackId}.m3u8`
      video.poster = poster
      video.controls = true
      video.playsInline = true
      video.autoplay = true
      // if the stream fails after all, fall back to the Mux player
      video.addEventListener('error', () => loadPlayer(facade, playbackId, poster), { once: true })
      facade.replaceChildren(video)
      video.play().catch(() => {})
      return
    }

    loadPlayer(facade, playbackId, poster)
  }

  document.querySelectorAll<HTMLElement>('.video-facade').forEach((facade) => {
    facade.addEventListener('click', () => play(facade))
  })
</script>
