---
import Layout from '@layout/Layout.astro'
import sanityFetch from '@repo/utils/sanity.fetch'
import metadataFetch from '@repo/utils/metadata.fetch'
import Breadcrumbs from '@repo/ui/Breadcrumbs.astro'
import { type Language } from '@repo/shared/languages'
import Components, { Components_Query, type ComponentsProps } from '@repo/shared/components/index.astro'
import { videoStill } from '@repo/ui/Video.astro'

type FetchDataReturn = NonNullable<Awaited<ReturnType<typeof fetchData>>>

interface Props extends FetchDataReturn {
  lang: Language
  slug: string
}

export async function fetchData(lang: Language, slug: string) {
  const page = await sanityFetch<{
    name: string
    components: ComponentsProps
    notionDatabaseId?: string
  }>({
    query: `
      *[_type == "LandingPage_Collection" && slug.current == $slug && language == $language][0] {
        name,
        "notionDatabaseId": components[_type == "ContactForm" && defined(notionDatabaseId)][0].notionDatabaseId,
        ${Components_Query}
      }
    `,
    params: { slug: slug, language: lang },
  })

  if (!page) return null
  const metadata = await metadataFetch(slug)
  return { page, metadata, lang, slug }
}

export async function staticPaths() {
  const prefix: Record<Language, string> = { pl: '/pl/', en: '/en/' }
  const pages = await sanityFetch<{ slug: string; language: Language }[]>({
    query: `
      *[_type == 'LandingPage_Collection'][] {
        "slug": slug.current,
        "language": language
      }
    `,
  })
  return pages?.map(({ slug, language }) => ({
    params: { lang: language, slug: slug.replace(prefix[language], '') },
  }))
}

const { page, metadata, slug } = Astro.props

const breadcrumbs = [{ name: page.name, path: slug }]

// When the page opens with a video, its still frame is the largest thing on the
// first screen. Preloading it from the head starts the download with the first
// bytes of the page instead of after the whole head has arrived.
type HeroMedia = { _type: string; hasUi?: boolean; asset?: { playbackId?: string } }
const hero = page.components?.[0] as unknown as { _type?: string; media?: HeroMedia[] } | undefined
const heroMedia = hero?._type === 'NarrowHeaderAndMedia' ? (hero.media?.length === 1 ? hero.media[0] : hero.media?.[1]) : undefined
const heroStill =
  heroMedia?._type === 'video' && heroMedia.hasUi && heroMedia.asset?.playbackId ? videoStill(heroMedia.asset.playbackId) : null
---

<Layout {...metadata} notionDatabaseId={page.notionDatabaseId}>
  {
    heroStill && (
      <link
        slot="Head"
        rel="preload"
        as="image"
        href={heroStill.src}
        imagesrcset={heroStill.srcset}
        imagesizes={heroStill.sizes}
        fetchpriority="high"
      />
    )
  }
  <Breadcrumbs data={breadcrumbs} isHidden={true} />
  <Components data={page.components} />
</Layout>

<script>
  import { trackEvent } from '@repo/shared/analytics'

  document.addEventListener('DOMContentLoaded', () => {
    trackEvent({
      meta: {
        eventName: 'ViewContent',
        contentName: document.title,
        params: {
          content_type: 'landing_page',
        },
      },
      ga4: {
        eventName: 'view_item',
        params: {
          items: [{ item_name: document.title, item_category: 'landing_page' }],
        },
      },
    })
  })
</script>
